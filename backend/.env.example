DATABASE_URL=postgresql://hin_user:hin_password@localhost:5432/nj_hin_db

API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ORIGIN_REGEX=

# Data Sources
NJ_CRASH_DATA_URL=https://data.nj.gov/resource/YOUR_DATASET_ID.json
CENSUS_API_KEY=your_census_api_key_here

DEFAULT_ANALYSIS_YEARS=5
CRASH_SNAP_DISTANCE_METERS=50
SEGMENT_LENGTH_MILES=0.1
SIGNIFICANCE_THRESHOLD=0.05

# Severity Weights
WEIGHT_FATAL=10
WEIGHT_SERIOUS_INJURY=5
WEIGHT_MINOR_INJURY=3
WEIGHT_PROPERTY_DAMAGE=1

APP_NAME=NJ High Injury Network Generator
APP_VERSION=0.1.0
DEBUG=false

# Anonymous access: no accounts. Keep the production HMAC secret server-side.
APP_ENVIRONMENT=local
# Production: set APP_ENVIRONMENT=production and a random secret of 32+ characters.
# ANONYMOUS_RATE_LIMIT_SECRET=
MAX_PENDING_ANALYSES=20
MAX_CLIENT_ACTIVE_ANALYSES=2
ANALYSIS_CREATE_LIMIT=5
ANALYSIS_CREATE_WINDOW_SECONDS=600
WORKER_MAX_ATTEMPTS=3
WORKER_STATEMENT_TIMEOUT_MS=300000
WORKER_LOCK_TIMEOUT_MS=5000
# Only trusted ingress IPs/networks; never '*' for a directly exposed API.
FORWARDED_ALLOW_IPS=127.0.0.1
