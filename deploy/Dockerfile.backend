# Backend image for the Oracle VM: API, worker and the official-data ingestion
# scripts share one image. Build context is the repo root.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl texlive-latex-base texlive-latex-recommended lmodern \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# requirements-ingest = API runtime + requests (the official NJGIN/NJDOT
# pipeline does its spatial work in PostGIS, so no GDAL/fiona is needed).
COPY backend/requirements.txt backend/requirements-ingest.txt ./
RUN python -m pip install --no-cache-dir -r requirements-ingest.txt

COPY backend/ ./
# Downloaded NJDOT archives and reports live on a volume mounted here.
RUN mkdir -p /srv/data/raw /srv/data/processed

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips \"${FORWARDED_ALLOW_IPS:-127.0.0.1}\" --limit-concurrency 32 --timeout-keep-alive 5"]
